{
    // C# Dev Kit: load the solution generated by Unity instead of building one from every .csproj found in the
    // repository. Without this it also picks up a package's source-generator project inside
    // unity/OnDemandMeshVR/Library/PackageCache and fails to restore it (NU1100 errors).
    "dotnet.defaultSolution": "unity/OnDemandMeshVR/OnDemandMeshVR.slnx"
}
